# ==============================
# Central database
# ==============================
DATABASE_URL="postgresql://postgres:bakary@localhost:5432/o"
DATABASE_ADMIN_URL="postgresql://postgres:bakary@localhost:5432/edusphere"
# ==============================
# Tenant provisioning
# ==============================
TENANT_DB_NAME_TEMPLATE="edusphere_%s"
TENANT_DB_URL_TEMPLATE=""
PRISMA_TENANT_SCHEMA_PATH="prisma/tenant/schema.prisma"
TENANT_BASE_DOMAIN="localhost"
TENANT_BASE_URL_TEMPLATE="http://{{slug}}.localhost:8080"
TENANT_DEFAULT_SCHEME="http"
TENANT_ADMIN_TEMP_PASSWORD="Password123!"

# ==============================
# Auth
# ==============================
JWT_SECRET="edusphere-super-secret-change-in-production-64chars-long-enough"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================
# Server
# ==============================
PORT=3000
NODE_ENV=development

# ==============================
# Email / notifications (Updated to SMTP)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre_app_password_gmail
MAIL_FROM_NAME="M&A Sante Assurance"
SMTP_CONNECTION_TIMEOUT=10000
SMTP_TIMEOUT=10000
SMTP_WRITE_TIMEOUT=10000

# Deprecated SendGrid (removed)
# TWILIO_SENDGRID_API_KEY=
# TWILIO_EMAIL_FROM="EduSphere <noreply@edusphere.com>"

# ==============================
# Uploads
# ==============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
